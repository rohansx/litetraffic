# Copy to .env and fill in what you need. Every variable here is optional:
# doctor, inspect, verify, up, diff and the dashboard run without any of them.
#
# LiteTraffic does not read .env itself. Load it into your shell first:
#   set -a; source .env; set +a

# --- Dashboard "Explain with AI" -------------------------------------------
# The first one that is set wins: ANTHROPIC_API_KEY, then OPENAI_API_KEY, then
# a local `claude` or `codex` CLI on PATH. The API keys need the `ai` extra:
#   python -m pip install -e '.[ai]'
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# With no API key set, pick which local CLI to use: claude or codex.
# Leave empty to use whichever is found first (claude, then codex).
LITETRAFFIC_EXPLAIN_CLI=

# --- Your own scenarios ------------------------------------------------------
# A manifest names its credential variables (secret_env, bearer_token_env,
# headers_env, origin_env, allowed_origins_env) and never holds the values.
# Add those variables here. The bundled examples need none.
