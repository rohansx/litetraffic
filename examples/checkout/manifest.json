{
  "schema_version": 1,
  "name": "checkout",
  "script": "journeys.js",
  "actors": [
    {
      "class": "buyer",
      "count": 8,
      "auth_recipe": "run-scoped-header"
    }
  ],
  "fixtures": {
    "recipe": "owned-shop",
    "parameters": {
      "small_carts": 80,
      "large_carts": 20
    }
  },
  "journeys": [
    {
      "name": "purchase",
      "max_requests": 3,
      "max_writes": 2
    }
  ],
  "schedule": {
    "unit": "journeys_per_second",
    "phases": [
      {
        "name": "warmup",
        "seconds": 1,
        "rate": 1
      },
      {
        "name": "measure",
        "seconds": 5,
        "rate": 2
      },
      {
        "name": "recovery",
        "seconds": 1,
        "rate": 1
      }
    ]
  },
  "assertions": [
    "one_effect_per_payment",
    "accepted_orders_persist",
    "order_totals_match"
  ],
  "observer": "owned-order-ledger",
  "budgets": {
    "max_seconds": 20,
    "max_requests": 40,
    "max_write_attempts": 25,
    "max_in_flight": 8,
    "max_artifact_bytes": 67108864
  }
}
