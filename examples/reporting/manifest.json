{
  "schema_version": 1,
  "name": "report-completeness",
  "script": "journeys.js",
  "actors": [
    {
      "class": "report-reader",
      "count": 6,
      "auth_recipe": "run-scoped-header"
    }
  ],
  "fixtures": {
    "recipe": "settled-sales-ledger",
    "parameters": {
      "expected_total": 1000,
      "expected_rows": 5
    },
    "owned_http": {
      "create_path": "/fixtures",
      "delete_path": "/fixtures/{fixture_id}",
      "id_pointer": "/id",
      "create_body": {"total": 1000, "row_count": 5}
    }
  },
  "journeys": [
    {
      "name": "read-sales-report",
      "max_requests": 1,
      "max_writes": 0
    }
  ],
  "schedule": {
    "unit": "journeys_per_second",
    "profile": {
      "kind": "random_bursts",
      "duration_seconds": 8,
      "quiet_rate": 0,
      "burst_rate": 3,
      "burst_seconds": 1,
      "bursts": 2
    }
  },
  "assertions": [
    "report_total_matches_fixture",
    "report_row_count_complete",
    "report_region_breakdown_complete",
    "report_response_valid",
    "ledger_matches_fixture"
  ],
  "observer": "sales-report-endpoint",
  "observation": {
    "path": "/reports/ledger",
    "assertion": "ledger_matches_fixture",
    "expected": {
      "/total": 1000,
      "/row_count": 5,
      "/regions/west": 100
    }
  },
  "budgets": {
    "max_seconds": 25,
    "max_requests": 9,
    "max_write_attempts": 2,
    "max_in_flight": 6,
    "max_artifact_bytes": 67108864
  }
}
