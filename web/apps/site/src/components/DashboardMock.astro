---
// Illustrative mock of the dashboard in the shadcn dashboard-01 layout (inset sidebar, KPI cards,
// area chart, data table), drawn in HTML. Run IDs, counts and timings are examples; they are
// consistent with each other, not real runs.
import VerdictBadge from "./VerdictBadge.astro";
import { badgeOutline, card, cardDescription, cardTitle, type Verdict } from "../lib/ui";

const icons = {
  overview:
    '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  runs: '<path d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13"/>',
  scenarios: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="m19 9-5 5-4-4-3 3"/>',
  compare:
    '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><path d="M11 18H8a2 2 0 0 1-2-2V9"/>',
  about: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>',
  up: '<path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/>',
  down: '<path d="M22 17 13.5 8.5 8.5 13.5 2 7"/><path d="M16 17h6v-6"/>',
  panel: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/>',
};

const tabs = [
  { id: "overview", label: "Overview", icon: icons.overview, path: "/" },
  { id: "runs", label: "Runs", icon: icons.runs, path: "/runs?scenario=checkout" },
  { id: "run", label: "…4c1e09aa", sub: true, path: "/runs/run_20260921T101204Z_4c1e09aa" },
  { id: "trend", label: "Scenarios", icon: icons.scenarios, path: "/scenarios/checkout" },
  { id: "diff", label: "Compare", icon: icons.compare, path: "/compare?baseline=…91b7d2f0&candidate=…4c1e09aa" },
];
const selected = "overview";

const kpis = [
  { label: "Runs", value: "14", trend: "+4", up: true, headline: "4 runs today", note: "5 scenarios" },
  { label: "Pass rate", value: "86%", trend: "2 not passing", up: false, headline: "12 of 14 runs pass", note: "One fail, one error" },
  { label: "Failing scenarios", value: "1", trend: "+1", up: true, headline: "checkout started failing", note: "Since …4c1e09aa" },
  { label: "Checkout p95", value: "4.1ms", trend: "+7.9%", up: true, headline: "Up from 3.8ms", note: "Against …91b7d2f0" },
];

// Runs per day, 15 to 21 Sep; the passing runs sit under the total.
const days = ["15 Sep", "16 Sep", "17 Sep", "18 Sep", "19 Sep", "20 Sep", "21 Sep"];
const totalPerDay = [1, 2, 1, 3, 1, 2, 4];
const passPerDay = [1, 2, 1, 3, 1, 2, 2];
const plot = (values: number[]) => {
  const pts = values.map((v, i) => [20 + (i * 520) / (values.length - 1), 160 - v * 32]);
  const line = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y}`).join(" ");
  return { line, area: `${line} L540 160 L20 160 Z` };
};
const totalPlot = plot(totalPerDay);
const passPlot = plot(passPerDay);

const runs: [string, Verdict, boolean, string, string][] = [
  ["run_20260921T101204Z_4c1e09aa", "fail", true, "4.1ms", "10:12"],
  ["run_20260921T100912Z_91b7d2f0", "pass", true, "3.8ms", "10:09"],
  ["run_20260921T094455Z_e02a7c13", "pass", false, "3.7ms", "09:44"],
  ["run_20260921T093310Z_5d88b6e1", "error", false, "n/a", "09:33"],
  ["run_20260920T171522Z_0b3f5a21", "pass", false, "3.5ms", "17:15"],
  ["run_20260920T164008Z_7ac19e42", "pass", false, "3.6ms", "16:40"],
];
const trend: [string, Verdict, string][] = [
  ["…7ac19e42", "pass", "3.6ms"],
  ["…0b3f5a21", "pass", "3.5ms"],
  ["…5d88b6e1", "error", "n/a"],
  ["…e02a7c13", "pass", "3.7ms"],
  ["…91b7d2f0", "pass", "3.8ms"],
  ["…4c1e09aa", "fail", "4.1ms"],
];

const tableWrap = "overflow-hidden overflow-x-auto rounded-lg border";
const table = "w-full border-collapse text-sm tabular-nums";
const thead = "bg-muted";
const th = "h-10 px-3 text-left align-middle text-xs font-medium whitespace-nowrap text-foreground";
const td = "border-t px-3 py-2.5 align-middle whitespace-nowrap";
const panel = "min-w-0 p-4 lg:p-6 focus-visible:-outline-offset-3";
const note = "mt-4 text-sm leading-relaxed text-muted-foreground";
const kpiCard = `${card} gap-3 bg-linear-to-t from-primary/5 to-card py-5 dark:bg-card`;
const tick = (on: boolean) =>
  `inline-grid size-4 place-items-center rounded-[4px] border align-middle shadow-xs ${on ? "border-primary bg-primary text-primary-foreground" : "border-input"}`;
const short = (id: string) => `…${id.slice(-8)}`;
---
<figure class="min-w-0 overflow-hidden rounded-xl border bg-sidebar shadow-sm" aria-labelledby="dash-caption">
  <div class="flex items-center gap-3 border-b px-4 py-2.5 text-xs">
    <span class="flex gap-1.5 max-sm:hidden" aria-hidden="true">
      <i class="size-2.5 rounded-full bg-border"></i><i class="size-2.5 rounded-full bg-border"></i><i class="size-2.5 rounded-full bg-border"></i>
    </span>
    <span class="min-w-0 truncate rounded-md border bg-background px-2.5 py-1 font-mono text-muted-foreground" data-dash-url>127.0.0.1:8780{tabs[0].path}</span>
    <span class={`${badgeOutline} ml-auto bg-background`}>Illustrative mock</span>
  </div>

  <div class="grid md:grid-cols-[200px_1fr]">
    <nav class="flex min-w-0 flex-col text-sidebar-foreground max-md:border-b" aria-label="Dashboard (mock)">
      <p class="flex items-center gap-2 px-4 pt-4 pb-2 font-heading text-sm font-semibold max-md:hidden">
        <span class="grid size-6 place-items-center rounded-md bg-sidebar-primary text-sidebar-primary-foreground"><svg class="size-3.5 fill-current" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 17h4v11H4zm7-9h4v20h-4zm7 5h4v15h-4zm7-9h4v24h-4z"></path></svg></span>LiteTraffic
      </p>
      <p class="px-4 pt-3 pb-1 text-xs font-medium text-sidebar-foreground/70 max-md:hidden" aria-hidden="true">Runs</p>
      <div class="flex gap-1 overflow-x-auto p-2 md:flex-col md:overflow-visible" role="tablist" aria-label="Dashboard views" data-dash-tabs>
        {tabs.map((t) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            data-path={t.path}
            aria-controls={`panel-${t.id}`}
            aria-selected={t.id === selected ? "true" : "false"}
            tabindex={t.id === selected ? 0 : -1}
            class:list={[
              "flex h-8 shrink-0 items-center gap-2 rounded-md px-2 text-left text-sm whitespace-nowrap hover:bg-sidebar-accent hover:text-sidebar-accent-foreground aria-selected:bg-sidebar-accent aria-selected:font-medium aria-selected:text-sidebar-accent-foreground",
              t.sub && "font-mono text-xs md:ml-6 md:border-l md:rounded-l-none md:pl-3",
            ]}
          >
            {t.icon && <svg class="size-4 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />}
            {t.label}
          </button>
        ))}
        <span class="flex h-8 shrink-0 items-center gap-2 px-2 text-sm text-sidebar-foreground/70 max-md:hidden" aria-hidden="true">
          <svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" set:html={icons.about} />About
        </span>
      </div>
      <div class="mx-2 mt-auto mb-2 flex items-center gap-2 rounded-md p-2 text-xs max-md:hidden">
        <span class="grid size-8 place-items-center rounded-lg bg-muted font-mono text-[11px]" aria-hidden="true">./</span>
        <span class="grid leading-tight"><span class="font-medium">Runs folder</span><span class="font-mono text-muted-foreground">./runs</span></span>
      </div>
    </nav>

    <div class="min-w-0 bg-background md:my-2 md:mr-2 md:rounded-xl md:shadow-sm">
      <div class="flex h-12 items-center gap-2 border-b px-4 lg:px-6">
        <svg class="size-4 fill-none stroke-current stroke-2 text-muted-foreground" viewBox="0 0 24 24" aria-hidden="true" set:html={icons.panel} />
        <span class="mx-1 h-4 w-px bg-border" aria-hidden="true"></span>
        <span class="text-sm font-medium">Runs dashboard</span>
      </div>

      <div class={panel} role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" tabindex="0">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-4">
          {kpis.map((k) => (
            <div class={kpiCard}>
              <div class="flex items-start justify-between gap-2 px-5">
                <div class="grid gap-1.5">
                  <span class={cardDescription}>{k.label}</span>
                  <span class="font-heading text-2xl font-semibold tabular-nums lg:text-3xl">{k.value}</span>
                </div>
                <span class={badgeOutline}><svg class="fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" set:html={k.up ? icons.up : icons.down} />{k.trend}</span>
              </div>
              <div class="grid gap-1 px-5 text-sm">
                <span class="flex items-center gap-2 font-medium">{k.headline}<svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true" set:html={k.up ? icons.up : icons.down} /></span>
                <span class="text-muted-foreground">{k.note}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-4 grid gap-4 xl:grid-cols-[1.6fr_1fr]">
          <section class={`${card} min-w-0 gap-4 py-5`} aria-labelledby="mock-chart-title">
            <div class="flex flex-wrap items-start justify-between gap-3 px-5">
              <div class="grid gap-1.5"><h3 id="mock-chart-title" class={cardTitle}>Runs per day</h3><span class={cardDescription}>Last 7 days, all scenarios</span></div>
              <span class="inline-flex rounded-md border text-xs shadow-xs" aria-hidden="true"><span class="bg-accent px-2.5 py-1 font-medium">7 days</span><span class="border-l px-2.5 py-1 text-muted-foreground">30 days</span></span>
            </div>
            <div class="px-3">
              <svg class="block w-full" viewBox="0 0 560 190" role="img" aria-label="Runs per day from 15 to 21 September: 1, 2, 1, 3, 1, 2 and 4 runs; every run passed except two of the four on 21 September">
                <defs>
                  <linearGradient id="mock-total" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stop-color="var(--primary)" stop-opacity="0.35" /><stop offset="95%" stop-color="var(--primary)" stop-opacity="0.05" /></linearGradient>
                  <linearGradient id="mock-pass" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stop-color="var(--primary)" stop-opacity="0.8" /><stop offset="95%" stop-color="var(--primary)" stop-opacity="0.1" /></linearGradient>
                </defs>
                <path class="fill-none stroke-border [stroke-dasharray:3_3]" d="M20 32H540M20 96H540M20 160H540" />
                <path fill="url(#mock-total)" d={totalPlot.area} /><path class="fill-none stroke-primary/50 stroke-[1.5]" d={totalPlot.line} />
                <path fill="url(#mock-pass)" d={passPlot.area} /><path class="fill-none stroke-primary stroke-[1.5]" d={passPlot.line} />
                <g class="fill-muted-foreground text-[11px]">
                  {days.map((d, i) => <text x={20 + (i * 520) / 6} y="182" text-anchor={i === 0 ? "start" : i === 6 ? "end" : "middle"}>{d}</text>)}
                </g>
              </svg>
            </div>
            <p class="flex flex-wrap gap-4 px-5 text-xs text-muted-foreground" aria-hidden="true">
              <span class="flex items-center gap-1.5"><i class="size-2.5 rounded-[2px] bg-primary"></i>Passed</span>
              <span class="flex items-center gap-1.5"><i class="size-2.5 rounded-[2px] bg-primary/30"></i>All runs</span>
            </p>
          </section>

          <section class={`${card} min-w-0 gap-4 py-5`} aria-labelledby="mock-failure-title">
            <div class="flex items-start justify-between gap-2 px-5">
              <div class="grid gap-1.5"><h3 id="mock-failure-title" class={cardTitle}>Recent failure</h3><span class="font-mono text-xs text-muted-foreground">one_effect_per_payment</span></div>
              <VerdictBadge verdict="fail" />
            </div>
            <div class="grid grid-cols-2 gap-3 px-5">
              <div class="rounded-lg border p-3"><span class="block text-xs text-muted-foreground">Expected</span><strong class="font-heading text-4xl leading-none font-semibold tabular-nums">1</strong></div>
              <div class="rounded-lg border border-fail/40 bg-fail-muted/60 p-3"><span class="block text-xs text-muted-foreground">Actual</span><strong class="font-heading text-4xl leading-none font-semibold text-fail tabular-nums">2</strong></div>
            </div>
            <p class="px-5 text-sm text-muted-foreground">One ledger effect per payment. The retried request created a second effect.</p>
            <p class="mt-auto flex items-center justify-between gap-2 border-t px-5 pt-4 text-sm">
              <span class="min-w-0 truncate font-mono text-xs">checkout …5d88b6e1</span><VerdictBadge verdict="error" />
            </p>
          </section>
        </div>

        <div class="mt-4">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <span class="inline-flex h-8 items-center rounded-lg bg-muted p-[3px] text-sm" aria-hidden="true"><span class="rounded-md bg-background px-2.5 py-0.5 font-medium shadow-sm">Recent runs</span><span class="px-2.5 text-muted-foreground">Scenarios <span class="ml-1 rounded-full bg-muted-foreground/30 px-1.5 text-xs">5</span></span></span>
            <span class="text-xs text-muted-foreground">Last run 10:12, 21 Sep, UTC</span>
          </div>
          <div class={tableWrap}>
            <table class={table}>
              <caption class="sr-only">Recent checkout runs, newest first</caption>
              <thead class={thead}><tr><th class={th} scope="col"><span class="sr-only">Selected</span></th><th class={th} scope="col">Run</th><th class={`${th} max-sm:hidden`} scope="col">Scenario</th><th class={th} scope="col">Verdict</th><th class={`${th} text-right max-sm:hidden`} scope="col">p95</th></tr></thead>
              <tbody>
                {runs.slice(0, 4).map(([id, v, on, p95]) => (
                  <tr class="hover:bg-muted/50">
                    <td class={`${td} w-8`}><span class={tick(on)} role="img" aria-label={on ? "ticked" : "not ticked"}>{on && <svg class="size-3 fill-none stroke-current stroke-3" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>}</span></td>
                    <td class={`${td} font-mono text-xs`}>{short(id)}</td>
                    <td class={`${td} max-sm:hidden`}><span class={`${badgeOutline} text-muted-foreground`}>checkout</span></td>
                    <td class={td}><VerdictBadge verdict={v} /></td>
                    <td class={`${td} text-right max-sm:hidden`}>{p95}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class={panel} role="tabpanel" id="panel-runs" aria-labelledby="tab-runs" tabindex="0" hidden>
        <div class="mb-4 flex flex-wrap items-end gap-2 text-xs" aria-hidden="true">
          {[["Scenario", "checkout"], ["Verdict", "any"], ["Seed", "any"]].map(([k, v]) => (
            <span class="grid min-w-24 gap-1"><small class="font-medium text-muted-foreground">{k}</small><b class="flex h-8 items-center rounded-md border border-input bg-background px-2.5 font-normal shadow-xs">{v}</b></span>
          ))}
          <span class="ml-auto inline-flex h-8 items-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground shadow-xs">Compare 2 runs</span>
        </div>
        <div class={tableWrap}>
          <table class={table}>
            <caption class="sr-only">Checkout runs, newest first, two ticked for comparison</caption>
            <thead class={thead}><tr><th class={th} scope="col"><span class="sr-only">Selected</span></th><th class={th} scope="col">Run</th><th class={`${th} max-sm:hidden`} scope="col">Seed</th><th class={`${th} max-sm:hidden`} scope="col">Lifecycle</th><th class={th} scope="col">Verdict</th></tr></thead>
            <tbody>
              {runs.map(([id, v, on]) => (
                <tr class="hover:bg-muted/50">
                  <td class={`${td} w-8`}><span class={tick(on)} role="img" aria-label={on ? "ticked" : "not ticked"}>{on && <svg class="size-3 fill-none stroke-current stroke-3" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>}</span></td>
                  <td class={`${td} max-w-40 truncate font-mono text-xs`}>{id}</td>
                  <td class={`${td} max-sm:hidden`}>42</td>
                  <td class={`${td} max-sm:hidden`}>finished</td>
                  <td class={td}><VerdictBadge verdict={v} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class={note}>Tick exactly two runs to compare them; the older one becomes the baseline. The <strong class="font-medium text-foreground">error</strong> run's target was unreachable, so no request got an HTTP response.</p>
      </div>

      <div class={panel} role="tabpanel" id="panel-run" aria-labelledby="tab-run" tabindex="0" hidden>
        <div class="flex items-start justify-between gap-4">
          <div><h3 class="font-heading text-2xl font-semibold tracking-tight">checkout</h3><p class="mt-1 text-sm text-muted-foreground">seed 42, lifecycle finished, journeys 12/12</p></div>
          <VerdictBadge verdict="fail" />
        </div>
        <div class="mt-4 inline-flex max-w-full gap-1 overflow-x-auto rounded-lg bg-muted p-[3px] text-sm text-muted-foreground" aria-hidden="true">
          <span class="rounded-md bg-background px-2.5 py-0.5 font-medium text-foreground shadow-sm">Assertions</span><span class="px-2.5 py-0.5">Observations</span><span class="px-2.5 py-0.5">Metrics</span><span class="px-2.5 py-0.5">Limitations</span><span class="px-2.5 py-0.5">Artifacts</span>
        </div>
        <div class={`${tableWrap} mt-4`}>
          <table class={table}>
            <caption class="sr-only">Assertions</caption>
            <thead class={thead}><tr><th class={th} scope="col">Assertion</th><th class={th} scope="col">Status</th><th class={th} scope="col">Samples</th></tr></thead>
            <tbody>
              <tr><td class={`${td} font-mono text-xs`}>one_effect_per_payment</td><td class={td}><VerdictBadge verdict="fail" /></td><td class={td}>12</td></tr>
              <tr><td class="border-t bg-muted/30 px-3 pt-1 pb-3" colspan="3">
                <table class={table}>
                  <caption class="py-1.5 text-left text-xs font-medium text-muted-foreground">Failing samples, first 3</caption>
                  <thead><tr><th class={th} scope="col">Sample</th><th class={th} scope="col">Logical key</th><th class={th} scope="col">Expected</th><th class={th} scope="col">Actual</th></tr></thead>
                  <tbody>
                    {[["4", "…4c1e09aa-1-0"], ["13", "…4c1e09aa-2-3"], ["22", "…4c1e09aa-4-6"]].map(([n, key]) => (
                      <tr><td class={td}>{n}</td><td class={`${td} font-mono text-xs`}>{key}</td><td class={td}>1</td><td class={`${td} font-semibold text-fail`}>2</td></tr>
                    ))}
                  </tbody>
                </table>
              </td></tr>
              <tr><td class={`${td} font-mono text-xs`}>accepted_orders_persist</td><td class={td}><VerdictBadge verdict="pass" /></td><td class={td}>12</td></tr>
              <tr><td class={`${td} font-mono text-xs`}>order_totals_match</td><td class={td}><VerdictBadge verdict="pass" /></td><td class={td}>12</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class={panel} role="tabpanel" id="panel-trend" aria-labelledby="tab-trend" tabindex="0" hidden>
        <div class={`${card} gap-3 py-5`}>
          <div class="grid gap-1.5 px-5"><span class={cardTitle}>p95 latency</span><span class={cardDescription}>checkout, oldest first</span></div>
          <svg class="block w-full px-3" viewBox="0 0 560 210" role="img" aria-label="p95 latency per checkout run, oldest first: 3.6, 3.5, 3.7 and 3.8 milliseconds passing, then 4.1 milliseconds failing">
            <defs><linearGradient id="mock-p95" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stop-color="var(--primary)" stop-opacity="0.5" /><stop offset="95%" stop-color="var(--primary)" stop-opacity="0.05" /></linearGradient></defs>
            <g class="fill-muted-foreground text-[13px] tabular-nums max-sm:text-[22px]">
              <text x="0" y="18">p95 ms</text><text x="0" y="46">4.5</text><text x="0" y="121">4.0</text><text x="0" y="196">3.5</text>
            </g>
            <path class="fill-none stroke-border [stroke-dasharray:3_3]" d="M44 40H550M44 115H550M44 190H550" />
            <path fill="url(#mock-p95)" d="M70 175L185 190L300 160L415 145L530 100L530 190L70 190Z" />
            <path class="fill-none stroke-primary stroke-2" d="M70 175L185 190L300 160L415 145L530 100" />
            <g class="stroke-card stroke-3">
              <circle class="fill-pass" cx="70" cy="175" r="7" /><circle class="fill-pass" cx="185" cy="190" r="7" /><circle class="fill-pass" cx="300" cy="160" r="7" /><circle class="fill-pass" cx="415" cy="145" r="7" /><circle class="fill-fail" cx="530" cy="100" r="7" />
            </g>
          </svg>
        </div>
        <div class={`${tableWrap} mt-4`}>
          <table class={table}>
            <caption class="sr-only">Checkout runs, oldest first</caption>
            <thead class={thead}><tr><th class={th} scope="col">Run</th><th class={`${th} max-sm:hidden`} scope="col">Seed</th><th class={th} scope="col">Verdict</th><th class={`${th} text-right`} scope="col">p95</th></tr></thead>
            <tbody>
              {trend.map(([id, v, p95]) => (
                <tr class="hover:bg-muted/50"><td class={`${td} font-mono text-xs`}>{id}</td><td class={`${td} max-sm:hidden`}>42</td><td class={td}><VerdictBadge verdict={v} /></td><td class={`${td} text-right`}>{p95}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class={note}>Runs are spaced evenly, not on a time scale. A run without a p95, like the error run, is left off the chart.</p>
      </div>

      <div class={panel} role="tabpanel" id="panel-diff" aria-labelledby="tab-diff" tabindex="0" hidden>
