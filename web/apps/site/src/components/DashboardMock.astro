<script>
  // Roving-tabindex tabs (WAI-ARIA tabs pattern); arrows move in either orientation.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-dash-tabs] [role=tab]")];
  const url = document.querySelector<HTMLElement>("[data-dash-url]")!;
  const select = (tab: HTMLButtonElement) => {
    url.textContent = `127.0.0.1:8780${tab.dataset.path}`;
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls") ?? "")!.hidden = !on;
    }
  };
  const step: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const to = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : e.key in step ? i + step[e.key] : null;
      if (to === null) return;
      e.preventDefault();
      const next = tabs[(to + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
