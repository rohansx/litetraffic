---
import { badgeOutline, button, buttonGhostSm, card, cardDescription, cardTitle, codeBlock, h2, label, lead, section, tabsList, tabsTrigger, wrap } from "../lib/ui";

const profiles = {
  spiky: {
    name: "Spiky",
    values: [2, 2, 2, 2, 7, 2, 2, 2, 2, 9, 2, 2, 2, 6, 2, 2, 2, 2],
    description: "A steady baseline interrupted by brief, high-volume spikes.",
    label: "Spiky traffic profile chart",
  },
  random: {
    name: "Random bursts",
    values: [0, 0, 5, 7, 4, 0, 0, 0, 8, 5, 0, 0, 3, 7, 6, 0, 0, 0],
    description: "Mostly quiet, with seeded bursts that arrive as short traffic mountains.",
    label: "Random burst traffic profile chart",
  },
  sustained: {
    name: "Sustained",
    values: [1, 2, 3, 5, 7, 8, 8, 8, 8, 8, 8, 8, 3, 1, 1, 1, 1, 1],
    description: "A controlled ramp into a plateau, followed by an immediate recovery drop.",
    label: "Sustained burst traffic profile chart",
  },
};
// Paths are drawn at build time; the toggle only shows one of the three.
const plot = (values: number[]) => {
  const [width, bottom, top, max] = [720, 275, 22, 10];
  const coords = values.map((v, i) => [(i * width) / (values.length - 1), bottom - (v / max) * (bottom - top)]);
  const line = coords.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
  return { line, area: `${line} L${width} ${bottom} L0 ${bottom} Z`, points: coords.filter((_, i) => i % 4 === 0) };
};
const plots = Object.entries(profiles).map(([id, p]) => ({ id, ...p, ...plot(p.values) }));

const scenarios = [
  ["Checkout", "Retry a payment", "One ledger effect per payment ID"],
  ["Inventory", "Compete for limited stock", "Accepted reservations stay within capacity"],
  ["Reporting", "Query a large organisation", "Totals and regional rows stay complete"],
  ["Cached search", "Update a hot result", "Reads become fresh after the update"],
  ["Tenant API", "Read as two identities", "Own records open; other tenants' do not. Ships with a <code>kit.json</code> for <code>init</code>"],
];

const commands = [
  ["doctor", "Checks k6 is exactly v2.2.0, Python is 3.11 or newer, the output directory is writable with 100 MiB free, and, with <code>--target</code>, that the app answers."],
  ["init", "Generates a tenant-isolation scenario bundle from a small JSON config, then validates it the way <code>inspect</code> does."],
  ["inspect", "Validates a scenario and explains it: actors, budgets, fixtures, secret variable names, observations with resolved expected values, and the schedule. Runs nothing."],
  ["approve", "Records a local approval that binds the scenario's digest to a target origin. <code>verify --require-approval</code> then refuses to run a scenario that changed after review."],
  ["verify", "Runs the scenario against a target and prints the verdict, each assertion, any limitations and the path to <code>report.html</code>. Repeat it across seeds with <code>--repeat</code>."],
  ["diff", "Compares a baseline and a candidate by run directory or run ID, with an optional p95 regression gate."],
  ["dashboard", "Serves your runs on 127.0.0.1 so you can filter them, read failing samples, chart a scenario over time and compare two runs."],
  ["up", "Repeats bounded runs as slices until Ctrl+C or a slice limit. It records each slice and gives no overall verdict."],
  ["prune", "Deletes old run directories by count or age, with a dry run to list them first."],
];
const exitCodes = [
  ["0", "pass"],
  ["1", "fail"],
  ["2", "inconclusive"],
  ["3", "error"],
  ["130", "cancelled"],
];

const install = [
  "git clone https://github.com/rohansx/litetraffic.git",
  "cd litetraffic",
  "python3 -m venv .venv && . .venv/bin/activate",
  "python -m pip install -e .",
];
const repo = "https://github.com/rohansx/litetraffic";
---
<section class={`${wrap} ${section} grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16`} id="profiles">
  <div>
    <p class={label}>Timing is part of behavior</p>
    <h2 class={h2}>Pressure has a shape.</h2>
    <p class={`${lead} max-w-md`}>A quiet baseline and a short rush reveal different failures. LiteTraffic resolves the profile before the run and records the exact schedule with its seed.</p>
  </div>
  <div class={`${card} min-w-0 gap-4 py-6`}>
    <div class="flex flex-wrap items-start justify-between gap-3 px-6">
      <div class="grid gap-1.5"><span class={cardTitle}>Traffic profile</span><span class={cardDescription}>Journeys / second, seed 42</span></div>
      <div class={`${tabsList} max-sm:w-full`} role="group" aria-label="Traffic profile">
        {plots.map((p, i) => <button type="button" class={tabsTrigger} aria-pressed={i === 0 ? "true" : "false"} data-profile={p.id}>{p.name}</button>)}
      </div>
    </div>
    <div class="px-6">
      <svg class="block w-full" viewBox="0 0 720 300" role="img" aria-label={plots[0].label} data-profile-chart>
        <defs>
          <linearGradient id="profile-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="5%" stop-color="var(--primary)" stop-opacity="0.8" />
            <stop offset="95%" stop-color="var(--primary)" stop-opacity="0.1" />
          </linearGradient>
        </defs>
        <path class="fill-none stroke-border [stroke-dasharray:3_3]" d="M0 60H720M0 120H720M0 180H720M0 240H720" aria-hidden="true" />
        {plots.map((p, i) => (
          <g data-profile-plot={p.id} data-label={p.label} data-description={p.description} display={i === 0 ? "inline" : "none"}>
            <path fill="url(#profile-fill)" d={p.area} />
            <path class="fill-none stroke-primary stroke-2 [vector-effect:non-scaling-stroke]" d={p.line} />
          </g>
        ))}
      </svg>
      <div class="mt-1 flex justify-between text-xs text-muted-foreground tabular-nums"><span>0s</span><span>30s</span><span>60s</span><span>90s</span></div>
    </div>
    <p class="min-h-[3em] border-t px-6 pt-4 text-sm leading-normal text-muted-foreground" aria-live="polite" data-profile-description>{plots[0].description}</p>
  </div>
</section>

<section class={`border-y bg-muted/40 ${section}`} id="scenarios">
  <div class={wrap}>
    <div class="max-w-2xl">
      <p class={label}>Five conformance scenarios</p>
      <h2 class={h2}>Designed to catch a wrong answer.</h2>
      <p class={lead}>Each example has a known-good app and a deliberate fault. The same scenario must pass one and fail the other.</p>
    </div>
    <div class={`${card} mt-10 overflow-hidden py-0 sm:mt-12`}>
      <table class="w-full text-sm">
        <thead class="bg-muted/60 max-sm:hidden">
          <tr class="border-b text-left"><th class="h-10 px-4 font-medium" scope="col">Scenario</th><th class="h-10 px-4 font-medium" scope="col">What the users do</th><th class="h-10 px-4 font-medium" scope="col">What must hold</th></tr>
        </thead>
        <tbody>
          {scenarios.map(([area, title, check]) => (
            <tr class="border-b last:border-0 hover:bg-muted/50 max-sm:grid max-sm:gap-1 max-sm:px-4 max-sm:py-3">
              <td class="px-4 py-3 align-top max-sm:p-0"><span class={badgeOutline}>{area}</span></td>
              <td class="px-4 py-3 align-top font-medium max-sm:p-0">{title}</td>
              <td class="px-4 py-3 align-top text-muted-foreground max-sm:p-0" set:html={check} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class={`${wrap} ${section}`} id="commands" aria-labelledby="commands-title">
  <div class="max-w-2xl">
    <p class={label}>The CLI</p>
    <h2 id="commands-title" class={h2}>Nine commands.</h2>
    <p class={lead}>Most print a short summary for people, or one JSON object with <code>--json</code> for scripts and agents.</p>
  </div>
  <dl class={`${card} mt-10 gap-0 divide-y py-0 sm:mt-12`}>
    {commands.map(([name, text]) => (
      <div class="grid gap-1.5 px-5 py-4 sm:grid-cols-[160px_1fr] sm:gap-6 sm:px-6">
        <dt><code class="font-mono text-sm font-semibold">{name}</code></dt>
        <dd class="max-w-3xl text-sm leading-relaxed text-muted-foreground" set:html={text} />
      </div>
    ))}
  </dl>
  <div class="mt-12">
    <h3 class="font-heading text-lg font-semibold">Exit codes for <code>verify</code></h3>
    <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-5">
      {exitCodes.map(([code, meaning]) => (
        <li class={`${card} gap-1 px-4 py-4`}>
          <span class={cardDescription}>{meaning}</span>
          <strong class:list={["font-heading text-3xl font-semibold tabular-nums", code === "1" && "text-fail"]}>{code}</strong>
        </li>
      ))}
    </ul>
    <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground">A target that never returns an HTTP response is an error, not a pass. A missing or mismatched approval also exits 3 before anything runs. Cancelling with Ctrl+C still saves the evidence collected so far. <code>diff</code> uses 0, 1 and 2 the same way for its comparison. Every command exits 2 on a usage error and 3 on an error. <a class="font-medium text-foreground underline underline-offset-4" href={`${repo}/blob/main/docs/cli.md#exit-codes`}>Exit codes for every command</a></p>
  </div>
</section>

<section class={`border-y bg-muted/40 ${section}`} id="targets">
  <div class={`${wrap} grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16`}>
    <div>
      <p class={label}>Works with a running HTTP app</p>
      <h2 class={h2}>Bring the target.<br />Keep the contract.</h2>
      <p class={lead}>Run the same reviewed scenario against localhost, a CI preview, or an existing E2B sandbox. Target addresses and secrets stay outside the portable scenario.</p>
    </div>
    <div>
      <ul class={`${card} gap-0 divide-y py-0 text-sm font-medium`}>
        {[["--target", "Local development"], ["--target", "CI and preview URLs"], ["--e2b-sandbox-id", "Existing E2B sandbox"]].map(([flag, text]) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-4">{text}<code class={`${badgeOutline} font-mono font-normal text-muted-foreground`}>{flag}</code></li>
        ))}
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-muted-foreground">Cloud metadata and link-local addresses are refused, in any spelling, before a request is sent. URLs with embedded credentials are refused, and k6 does not follow redirects.</p>
    </div>
  </div>
</section>

<section class={section} id="start">
  <div class={`${wrap} grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16`}>
    <div>
      <p class={label}>Developer preview</p>
      <h2 class={h2}>Start with a scenario you can read.</h2>
      <p class="mt-4 max-w-lg leading-relaxed text-muted-foreground">Scenarios are handwritten k6 journeys, or generated by <code>init tenant-isolation</code>, and you review them before running. Install k6 v2.2.0 separately, then install LiteTraffic from source.</p>
      <div class="mt-7 mb-8 grid gap-6 sm:grid-cols-2">
        {[
          ["Works today", ["Nine commands, local runs and repeats", "Tenant-isolation scenarios from a JSON config", "Seeded traffic profiles and budgets", "Fixtures, test JWTs and final observations", "Reports, approvals and run comparison"]],
          ["Not shipped yet", ["AI or automatic scenario authoring", "Persistent users across runs", "Managed sandboxes", "A PyPI release"]],
        ].map(([title, items], col) => (
          <div>
            <h3 class="mb-2 font-heading text-sm font-semibold">{title}</h3>
            <ul class="grid gap-2 text-sm text-muted-foreground">{(items as string[]).map((item) => (
              <li class="flex gap-2">
                <svg class="mt-0.5 size-4 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">{col === 0 ? <path d="M20 6 9 17l-5-5" /> : <circle cx="12" cy="12" r="8" class="[stroke-dasharray:3_3]" />}</svg>{item}
              </li>
            ))}</ul>
          </div>
        ))}
      </div>
      <a class={button} href={`${repo}/blob/main/docs/quickstart.md`}>Read the quickstart</a>
    </div>
    <div class={`${card} min-w-0 gap-0 overflow-hidden py-0`}>
      <div class="flex items-center justify-between gap-4 border-b px-5 py-2.5 text-sm text-muted-foreground">
        <span>Install from source</span>
        <button id="copy-command" type="button" class={buttonGhostSm} data-copy={install.join("\n")}>Copy install commands</button>
      </div>
      <pre class={`${codeBlock} bg-muted/40 px-5 py-5 leading-loose max-sm:text-[10px]`}><code>{[...install, "litetraffic doctor", "litetraffic verify examples/checkout \\\n    --target http://127.0.0.1:8765 --seed 42", "litetraffic dashboard"].map((line, i) => <>{i > 0 && "\n"}<span class="text-muted-foreground select-none">$</span> {line}</>)}</code></pre>
    </div>
  </div>
</section>

<section class="pb-16 sm:pb-24">
  <div class={wrap}>
    <div class="rounded-xl bg-primary px-6 py-12 text-primary-foreground shadow-sm sm:px-12 sm:py-16">
      <p class="mb-3 text-sm font-medium opacity-70">For developers, agents, and the systems they change.</p>
      <h2 class="max-w-3xl font-heading text-3xl font-semibold tracking-tight text-balance sm:text-5xl">Give the app a world.<br />Then ask what survived.</h2>
      <a class="mt-8 inline-flex h-10 items-center justify-center gap-2 rounded-md bg-primary-foreground px-6 text-sm font-medium text-primary shadow-xs transition-all outline-none hover:bg-primary-foreground/90 focus-visible:ring-[3px] focus-visible:ring-primary-foreground/50" href={`${repo}/tree/main/docs`}>Read the documentation <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-profile]");
  const chart = document.querySelector("[data-profile-chart]")!;
  const description = document.querySelector("[data-profile-description]")!;
  for (const button of buttons) {
    button.addEventListener("click", () => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      for (const g of document.querySelectorAll<SVGGElement>("[data-profile-plot]")) {
        const on = g.dataset.profilePlot === button.dataset.profile;
        g.setAttribute("display", on ? "inline" : "none");
        if (on) {
          chart.setAttribute("aria-label", g.dataset.label!);
          description.textContent = g.dataset.description!;
        }
      }
    });
  }

  const copy = document.querySelector<HTMLButtonElement>("#copy-command")!;
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copy.textContent = "Copied";
      setTimeout(() => (copy.textContent = "Copy install commands"), 1600);
    } catch (_) {
      copy.textContent = "Select command";
    }
  });
</script>
