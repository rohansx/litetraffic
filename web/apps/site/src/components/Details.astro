---
import { button, h2, label, lead, wrap } from "../lib/ui";

const profiles = {
  spiky: {
    name: "Spiky",
    values: [2, 2, 2, 2, 7, 2, 2, 2, 2, 9, 2, 2, 2, 6, 2, 2, 2, 2],
    description: "A steady baseline interrupted by brief, high-volume spikes.",
    label: "Spiky traffic profile chart",
  },
  random: {
    name: "Random bursts",
    values: [0, 0, 5, 7, 4, 0, 0, 0, 8, 5, 0, 0, 3, 7, 6, 0, 0, 0],
    description: "Mostly quiet, with seeded bursts that arrive as short traffic mountains.",
    label: "Random burst traffic profile chart",
  },
  sustained: {
    name: "Sustained",
    values: [1, 2, 3, 5, 7, 8, 8, 8, 8, 8, 8, 8, 3, 1, 1, 1, 1, 1],
    description: "A controlled ramp into a plateau, followed by an immediate recovery drop.",
    label: "Sustained burst traffic profile chart",
  },
};
// Paths are drawn at build time; the toggle only shows one of the three.
const plot = (values: number[]) => {
  const [width, bottom, top, max] = [720, 275, 22, 10];
  const coords = values.map((v, i) => [(i * width) / (values.length - 1), bottom - (v / max) * (bottom - top)]);
  const line = coords.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
  return { line, area: `${line} L${width} ${bottom} L0 ${bottom} Z`, points: coords.filter((_, i) => i % 4 === 0) };
};
const plots = Object.entries(profiles).map(([id, p]) => ({ id, ...p, ...plot(p.values) }));

const scenarios = [
  ["Checkout", "Retry a payment", "One ledger effect per payment ID"],
  ["Inventory", "Compete for limited stock", "Accepted reservations stay within capacity"],
  ["Reporting", "Query a large organisation", "Totals and regional rows stay complete"],
  ["Cached search", "Update a hot result", "Reads become fresh after the update"],
  ["Tenant API", "Read as two identities", "Own records open; other tenants' do not. Ships with a <code>kit.json</code> for <code>init</code>"],
];

const commands = [
  ["doctor", "Checks k6 is exactly v2.2.0, Python is 3.11 or newer, the output directory is writable with 100 MiB free, and, with <code>--target</code>, that the app answers."],
  ["init", "Generates a tenant-isolation scenario bundle from a small JSON config, then validates it the way <code>inspect</code> does."],
  ["inspect", "Validates a scenario and explains it: actors, budgets, fixtures, secret variable names, observations with resolved expected values, and the schedule. Runs nothing."],
  ["approve", "Records a local approval that binds the scenario's digest to a target origin. <code>verify --require-approval</code> then refuses to run a scenario that changed after review."],
  ["verify", "Runs the scenario against a target and prints the verdict, each assertion, any limitations and the path to <code>report.html</code>. Repeat it across seeds with <code>--repeat</code>."],
  ["diff", "Compares a baseline and a candidate by run directory or run ID, with an optional p95 regression gate."],
  ["dashboard", "Serves your runs on 127.0.0.1 so you can filter them, read failing samples, chart a scenario over time and compare two runs."],
  ["up", "Repeats bounded runs as slices until Ctrl+C or a slice limit. It records each slice and gives no overall verdict."],
  ["prune", "Deletes old run directories by count or age, with a dry run to list them first."],
];
const exitCodes = [
  ["0", "pass"],
  ["1", "fail"],
  ["2", "inconclusive"],
  ["3", "error"],
  ["130", "cancelled"],
];

const install = [
  "git clone https://github.com/rohansx/litetraffic.git",
  "cd litetraffic",
  "python3 -m venv .venv && . .venv/bin/activate",
  "python -m pip install -e .",
];
const repo = "https://github.com/rohansx/litetraffic";
const toggleBtn =
  "rounded-md border px-3 py-2 text-xs font-semibold hover:bg-accent aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground";
---
<section class={`${wrap} grid items-center gap-14 py-20 sm:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:py-36`} id="profiles">
  <div>
    <p class={label}>Timing is part of behavior</p>
    <h2 class={h2}>Pressure has a shape.</h2>
    <p class={`${lead} max-w-[430px]`}>A quiet baseline and a short rush reveal different failures. LiteTraffic resolves the profile before the run and records the exact schedule with its seed.</p>
    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Traffic profile">
      {plots.map((p, i) => <button type="button" class={toggleBtn} aria-pressed={i === 0 ? "true" : "false"} data-profile={p.id}>{p.name}</button>)}
    </div>
    <p class="mt-5 min-h-[3em] text-sm leading-normal text-muted-foreground" aria-live="polite" data-profile-description>{plots[0].description}</p>
  </div>
  <div class="min-w-0 rounded-xl border bg-sidebar p-4 text-foreground shadow-sm scheme-dark sm:p-6">
    <div class="flex justify-between text-xs text-muted-foreground tabular-nums"><span>journeys / second</span><strong class="font-semibold text-brand">seed 42</strong></div>
    <svg class="mt-4 mb-1 block w-full" viewBox="0 0 720 300" role="img" aria-label={plots[0].label} data-profile-chart>
      <path class="fill-none stroke-border" d="M0 60H720M0 120H720M0 180H720M0 240H720" aria-hidden="true" />
      {plots.map((p, i) => (
        <g data-profile-plot={p.id} data-label={p.label} data-description={p.description} display={i === 0 ? "inline" : "none"}>
          <path class="fill-brand/20" d={p.area} />
          <path class="fill-none stroke-brand stroke-4 [stroke-linecap:round] [stroke-linejoin:round] [vector-effect:non-scaling-stroke]" d={p.line} />
          {p.points.map(([x, y]) => <circle class="fill-sidebar stroke-brand stroke-3" cx={x} cy={y} r="4" />)}
        </g>
      ))}
    </svg>
    <div class="flex justify-between text-xs text-muted-foreground tabular-nums"><span>0s</span><span>30s</span><span>60s</span><span>90s</span></div>
  </div>
</section>

<section class="bg-sidebar py-20 text-foreground scheme-dark sm:py-28" id="scenarios">
  <div class={wrap}>
    <div class="max-w-[780px]">
      <p class="mb-5 text-sm font-semibold text-brand">Five conformance scenarios</p>
      <h2 class={h2}>Designed to catch a wrong answer.</h2>
      <p class={lead}>Each example has a known-good app and a deliberate fault. The same scenario must pass one and fail the other.</p>
    </div>
    <ul class="mt-12 border-t sm:mt-16">
      {scenarios.map(([area, title, check]) => (
        <li class="grid gap-1 border-b py-5 sm:min-h-22 sm:grid-cols-[125px_1fr_1.1fr] sm:items-center sm:gap-5 sm:py-3 lg:grid-cols-[155px_1fr_1.2fr]">
          <span class="text-xs text-muted-foreground">{area}</span>
          <strong class="font-display text-[1.375rem] font-bold">{title}</strong>
          <p class="text-sm text-muted-foreground" set:html={check} />
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="border-b bg-card py-20 sm:py-28 lg:py-32" id="commands" aria-labelledby="commands-title">
  <div class={wrap}>
    <div class="max-w-[780px]">
      <p class={label}>The CLI</p>
      <h2 id="commands-title" class={h2}>Nine commands.</h2>
      <p class={lead}>Most print a short summary for people, or one JSON object with <code>--json</code> for scripts and agents.</p>
    </div>
    <dl class="mt-10 border-t-2 border-foreground sm:mt-16">
      {commands.map(([name, text]) => (
        <div class="grid gap-1.5 border-b py-5 sm:grid-cols-[200px_1fr] sm:gap-6 sm:py-6">
          <dt><code class="font-display text-[1.7rem] font-bold">{name}</code></dt>
          <dd class="max-w-[680px] text-[15px] leading-normal text-muted-foreground sm:pt-1.5" set:html={text} />
        </div>
      ))}
    </dl>
    <div class="mt-16">
      <h3 class="font-sans text-lg font-semibold">Exit codes for <code>verify</code></h3>
      <ul class="mt-5 grid grid-cols-3 overflow-hidden rounded-xl border sm:grid-cols-5">
        {exitCodes.map(([code, meaning]) => (
          <li class="border-r border-b p-3.5 sm:border-b-0 sm:p-4.5 sm:last:border-r-0">
            <strong class:list={["block font-display text-[2.4rem] leading-none tabular-nums sm:text-[2.9rem]", code === "1" && "text-fail"]}>{code}</strong>
            <span class="mt-1.5 block text-[13px] text-muted-foreground">{meaning}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 max-w-[680px] text-sm leading-relaxed text-muted-foreground">A target that never returns an HTTP response is an error, not a pass. A missing or mismatched approval also exits 3 before anything runs. Cancelling with Ctrl+C still saves the evidence collected so far. <code>diff</code> uses 0, 1 and 2 the same way for its comparison. Every command exits 2 on a usage error and 3 on an error. <a class="border-b border-foreground font-semibold text-foreground" href={`${repo}/blob/main/docs/cli.md#exit-codes`}>Exit codes for every command</a></p>
    </div>
  </div>
</section>

<section class={`${wrap} grid gap-9 py-20 sm:py-28 lg:grid-cols-[1fr_0.8fr] lg:gap-24 lg:py-36`} id="targets">
  <div>
    <p class={label}>Works with a running HTTP app</p>
    <h2 class={h2}>Bring the target.<br />Keep the contract.</h2>
  </div>
  <div>
    <p class="mb-9 text-lg leading-relaxed text-muted-foreground">Run the same reviewed scenario against localhost, a CI preview, or an existing E2B sandbox. Target addresses and secrets stay outside the portable scenario.</p>
    <ul class="divide-y border-y font-semibold">
      {[["--target", "Local development"], ["--target", "CI and preview URLs"], ["--e2b-sandbox-id", "Existing E2B sandbox"]].map(([flag, text]) => (
        <li class="py-4"><span class="inline-block min-w-38 font-mono text-xs font-normal text-muted-foreground max-sm:mb-1 max-sm:block">{flag}</span>{text}</li>
      ))}
    </ul>
    <p class="mt-6 text-[15px] leading-relaxed text-muted-foreground">Cloud metadata and link-local addresses are refused, in any spelling, before a request is sent. URLs with embedded credentials are refused, and k6 does not follow redirects.</p>
  </div>
</section>

<section class="bg-muted py-20 sm:py-28" id="start">
  <div class={`${wrap} grid items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16`}>
    <div>
      <p class={label}>Developer preview</p>
      <h2 class={h2}>Start with a scenario you can read.</h2>
      <p class="mt-6 max-w-[490px] leading-relaxed text-muted-foreground">Scenarios are handwritten k6 journeys, or generated by <code>init tenant-isolation</code>, and you review them before running. Install k6 v2.2.0 separately, then install LiteTraffic from source.</p>
      <div class="mt-7 mb-8 grid gap-6 sm:grid-cols-2">
        {[
          ["Works today", ["Nine commands, local runs and repeats", "Tenant-isolation scenarios from a JSON config", "Seeded traffic profiles and budgets", "Fixtures, test JWTs and final observations", "Reports, approvals and run comparison"]],
          ["Not shipped yet", ["AI or automatic scenario authoring", "Persistent users across runs", "Managed sandboxes", "A PyPI release"]],
        ].map(([title, items]) => (
          <div>
            <h3 class="mb-2 font-sans text-sm font-semibold">{title}</h3>
            <ul class="divide-y border-y text-sm text-muted-foreground">{(items as string[]).map((item) => <li class="py-2.5">{item}</li>)}</ul>
          </div>
        ))}
      </div>
      <a class={button} href={`${repo}/blob/main/docs/quickstart.md`}>Read the quickstart</a>
    </div>
    <div class="min-w-0 overflow-hidden rounded-xl border bg-sidebar text-foreground shadow-sm scheme-dark">
      <div class="flex items-center justify-between gap-4 border-b px-5 py-3 text-xs text-muted-foreground">
        <span>install from source</span>
        <button id="copy-command" type="button" class="rounded-md px-2 py-1 font-semibold text-brand hover:bg-sidebar-accent" aria-label="Copy install commands" data-copy={install.join("\n")}>Copy install commands</button>
      </div>
      <pre class="overflow-x-auto px-4 py-5 font-mono text-[10px] leading-loose sm:px-5 sm:py-7 sm:text-xs"><code>{[...install, "litetraffic doctor", "litetraffic verify examples/checkout \\\n    --target http://127.0.0.1:8765 --seed 42", "litetraffic dashboard"].map((line, i) => <>{i > 0 && "\n"}<span class="text-brand">$</span> {line}</>)}</code></pre>
    </div>
  </div>
</section>

<section class="bg-brand py-20 text-brand-foreground sm:py-28">
  <div class={wrap}>
    <p class="mb-4 font-semibold">For developers, agents, and the systems they change.</p>
    <h2 class="max-w-[920px] text-[clamp(3.5rem,7vw,5.875rem)] leading-[0.97] font-bold text-balance">Give the app a world.<br />Then ask what survived.</h2>
    <a class="mt-10 inline-block border-b-2 border-current pb-1.5 font-bold focus-visible:outline-brand-foreground" href={`${repo}/tree/main/docs`}>Read the documentation <span class="ml-2" aria-hidden="true">↗</span></a>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-profile]");
  const chart = document.querySelector("[data-profile-chart]")!;
  const description = document.querySelector("[data-profile-description]")!;
  for (const button of buttons) {
    button.addEventListener("click", () => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      for (const g of document.querySelectorAll<SVGGElement>("[data-profile-plot]")) {
        const on = g.dataset.profilePlot === button.dataset.profile;
        g.setAttribute("display", on ? "inline" : "none");
        if (on) {
          chart.setAttribute("aria-label", g.dataset.label!);
          description.textContent = g.dataset.description!;
        }
      }
    });
  }

  const copy = document.querySelector<HTMLButtonElement>("#copy-command")!;
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copy.textContent = "Copied";
      setTimeout(() => (copy.textContent = "Copy install commands"), 1600);
    } catch (_) {
      copy.textContent = "Select command";
    }
  });
</script>
