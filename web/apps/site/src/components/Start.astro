---
// First run from the README, where it runs (targets), what is not shipped yet, and the closing CTA.
import { button, buttonGhostSm, buttonOutline, chip, codeBlock, doc, h2, kicker, lead, repo, section, wrap } from "../lib/ui";
import GitHubIcon from "./GitHubIcon.astro";

const install = [
  "git clone https://github.com/rohansx/litetraffic.git",
  "cd litetraffic",
  "python3 -m venv .venv && . .venv/bin/activate",
  "python -m pip install -e .",
];
const run = [
  "litetraffic doctor",
  "python examples/checkout/server.py --port 8765 &",
  "litetraffic verify examples/checkout \\\n    --target http://127.0.0.1:8765 --seed 42",
  "litetraffic dashboard",
];
const targets = [
  ["Local development", "--target http://127.0.0.1:8765"],
  ["CI and preview URLs", "--target https://…"],
  ["An existing E2B sandbox", "--e2b-sandbox-id ID --e2b-port PORT"],
];
const notYet = ["AI or automatic scenario authoring", "Persistent users across runs", "Managed sandboxes", "A PyPI release"];
---
<section class={`${wrap} ${section} grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16`} id="start" aria-labelledby="start-title">
  <div>
    <p class={kicker}>first run · from the readme</p>
    <h2 id="start-title" class={`${h2} mt-2`}>Run the checkout example.</h2>
    <p class={lead}>Install k6 v2.2.0 separately, then LiteTraffic from source. The expected result is a pass with 12 journeys and 36 requests. Restart the demo server with <code>--wrong-duplicate</code> to watch it fail.</p>

    <div class="mt-8" id="targets">
      <h3 class="font-heading text-sm font-semibold">Where it runs</h3>
      <ul class="mt-3 divide-y rounded-lg border bg-card text-sm">
        {targets.map(([text, flag]) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">{text}<code class={`${chip} max-w-full truncate`}>{flag}</code></li>
        ))}
      </ul>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">Cloud metadata and link-local addresses are refused before a request is sent, and k6 does not follow redirects.</p>
    </div>

    <div class="mt-8">
      <h3 class="font-heading text-sm font-semibold">Not shipped yet</h3>
      <ul class="mt-3 flex flex-wrap gap-2">{notYet.map((item) => <li class={chip}>{item}</li>)}</ul>
    </div>
  </div>

  <div class="min-w-0 lg:pt-8">
    <div class="bracket-frame">
      <div class="window-card">
        <div class="window-card-header">
          <span>terminal · first run</span>
          <button id="copy-command" type="button" class={`${buttonGhostSm} ml-auto h-7 font-mono text-xs`} data-copy={install.join("\n")}>Copy install commands</button>
        </div>
        <pre class={`${codeBlock} px-4 py-4 leading-loose sm:px-5 max-sm:text-[10.5px]`} tabindex="0"><code>{[...install, ...run].map((line, i) => <>{i > 0 && "\n"}<span class="text-brand-text select-none">$</span> {line}</>)}</code></pre>
        <p class="flex items-center gap-2 border-t px-4 py-3 font-mono text-xs sm:px-5"><span class="signal" data-verdict="pass" aria-hidden="true"></span>verdict: pass · journeys 12/12</p>
      </div>
    </div>
  </div>
</section>

<section class={`${wrap} pb-16 sm:pb-24`} aria-labelledby="cta-title">
  <hr class="lane-divider [--lane-color:var(--brand)]" />
  <div class="grid gap-8 pt-14 sm:pt-20 lg:grid-cols-[1fr_auto] lg:items-end">
    <div>
      <p class="eyebrow">developer preview · 0.1.0.dev0</p>
      <h2 id="cta-title" class="mt-4 font-heading text-4xl font-semibold tracking-tight text-balance sm:text-6xl">Give the app a world.<br />Then ask what survived.</h2>
      <p class={lead}>Run the included examples today, then write a scenario for your own API. Open source, MIT licensed, no hosted account.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a class={button} href={doc("docs/quickstart.md")}>Read the quickstart</a>
      <a class={buttonOutline} href={repo}><GitHubIcon />Star on GitHub</a>
    </div>
  </div>
</section>

<script>
  const copy = document.querySelector<HTMLButtonElement>("#copy-command")!;
  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copy.textContent = "Copied";
      setTimeout(() => (copy.textContent = "Copy install commands"), 1600);
    } catch (_) {
      copy.textContent = "Select the commands to copy";
    }
  });
</script>
