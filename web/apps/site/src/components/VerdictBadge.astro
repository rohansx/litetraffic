---
// Outline badge with the shared three-lamp signal; the verdict word is always shown.
import { badgeOutline, type Verdict } from "../lib/ui";

interface Props {
  verdict: Verdict;
  class?: string;
}
const { verdict, class: extra } = Astro.props;
const word = { pass: "Pass", fail: "Fail", error: "Error", inconclusive: "Inconclusive" }[verdict];
---
<span class:list={[badgeOutline, "font-mono", extra]}>
  <span class="signal" data-verdict={verdict} aria-hidden="true"></span>{word}
</span>
