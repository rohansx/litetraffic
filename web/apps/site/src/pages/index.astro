---
import Base from "../layouts/Base.astro";
import RunPreview from "../components/RunPreview.astro";
import VerdictCompare from "../components/VerdictCompare.astro";
import Features from "../components/Features.astro";
import Commands from "../components/Commands.astro";
import Start from "../components/Start.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import { button, buttonGhostSm, buttonIcon, buttonOutline, buttonSm, doc, repo, wrap } from "../lib/ui";

const nav = [
  ["#mechanics", "How it works"],
  ["#verdict", "Verdicts"],
  ["#features", "Features"],
  ["#commands", "Commands"],
];
const footer: [string, [string, string][]][] = [
  ["Product", [["Quickstart", doc("docs/quickstart.md")], ["Installation", doc("docs/installation.md")], ["CLI reference", doc("docs/cli.md")], ["Roadmap", doc("docs/roadmap.md")]]],
  ["Docs", [["Writing scenarios", doc("docs/scenarios.md")], ["Results and reports", doc("docs/results.md")], ["Safety", doc("docs/safety.md")], ["Troubleshooting", doc("docs/troubleshooting.md")]]],
  ["Project", [["GitHub", repo], ["Contributing", doc("CONTRIBUTING.md")], ["Security", doc("SECURITY.md")], ["License", doc("LICENSE")]]],
];
---
<Base
  title="LiteTraffic: Users as an API"
  description="LiteTraffic runs stateful synthetic users against a running app on a seeded schedule, checks the business effects they leave behind, and keeps the evidence."
>
  <header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70">
    <div class={`${wrap} flex h-14 items-center justify-between gap-4`}>
      <a class="flex items-center gap-2 font-heading text-base font-semibold whitespace-nowrap" href="#main" aria-label="LiteTraffic home">
        <span class="grid size-7 place-items-center rounded-md bg-primary text-primary-foreground" aria-hidden="true">
          <svg class="size-4" viewBox="0 0 32 32"><path class="fill-current" d="M4 17h4v11H4zm7-9h4v20h-4zm7 5h4v15h-4z"></path><path class="fill-brand" d="M25 4h4v24h-4z"></path></svg>
        </span><span>LiteTraffic</span>
      </a>
      <nav class="flex items-center gap-1" aria-label="Main navigation">
        {nav.map(([href, text]) => (
          <a class={`${buttonGhostSm} text-muted-foreground decoration-brand decoration-2 underline-offset-[6px] hover:text-foreground hover:underline max-lg:hidden`} href={href}>{text}</a>
        ))}
        <a class={`${buttonGhostSm} font-mono text-xs text-muted-foreground max-sm:hidden`} href={repo}><GitHubIcon />GitHub</a>
        <button id="theme-toggle" type="button" class={buttonIcon} aria-label="Dark mode" aria-pressed="false">
          <svg class="fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path class="fill-current stroke-none" d="M12 3a9 9 0 0 1 0 18z"></path></svg>
        </button>
        <a class={`${buttonSm} ml-1`} href="#start">Get started</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="grid-bg border-b [--grid-size:2.5rem]" aria-labelledby="hero-title">
      <div class={`${wrap} flex flex-col items-center py-20 text-center sm:py-28`}>
        <p class="eyebrow">developer preview · 0.1.0.dev0</p>
        <h1 id="hero-title" class="mt-6 font-heading text-6xl leading-[0.95] font-bold tracking-tight sm:text-7xl lg:text-8xl">Users<br />as an API.</h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground">Give a running app a population of stateful synthetic users. Replay what they do on a seeded schedule, then check the business effects they leave behind.</p>
        <div class="mt-9 grid w-full max-w-xs gap-3 sm:flex sm:max-w-none sm:justify-center">
          <a class={button} href="#start"><svg class="fill-brand" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" /></svg>Run a scenario</a>
          <a class={buttonOutline} href={repo}><GitHubIcon />Star on GitHub</a>
        </div>
        <figure class="mt-10 w-full max-w-md rounded-lg border bg-card/80 text-left font-mono text-xs shadow-xs sm:text-[13px]">
          <figcaption class="sr-only">The documented first run of the checkout example</figcaption>
          <p class="border-b px-4 whitespace-pre py-2.5 text-muted-foreground"><span class="text-brand-text">$</span> {"litetraffic verify examples/checkout \\\n    --target http://127.0.0.1:8765 --seed 42"}</p>
          <p class="flex items-center gap-2.5 px-4 py-2.5"><span class="signal [--signal-dot:0.625rem]" data-verdict="pass" aria-hidden="true"></span>pass<span class="text-muted-foreground">· 12/12 journeys · 36 requests</span></p>
        </figure>
      </div>
      <div class={wrap}><hr class="ruler" /></div>
    </section>

    <RunPreview />
    <VerdictCompare />
    <Features />
    <Commands />
    <Start />
  </main>

  <footer class="border-t">
    <div class={`${wrap} grid gap-10 py-12 sm:grid-cols-3 lg:grid-cols-[1.6fr_1fr_1fr_1fr]`}>
      <div class="sm:col-span-3 lg:col-span-1">
        <a class="flex items-center gap-2 font-heading text-lg font-semibold" href="#main">LiteTraffic</a>
        <p class="mt-3 max-w-xs text-sm text-muted-foreground">Users as an API. Evidence as the result.</p>
        <p class="mt-4 border-l-2 border-brand pl-3 font-mono text-xs text-muted-foreground">Local-first · Linux verified · k6 v2.2.0</p>
      </div>
      {footer.map(([title, links]) => (
        <div>
          <h2 class="font-mono text-xs font-medium text-muted-foreground">{title}</h2>
          <ul class="mt-3 grid gap-2 text-sm">
            {links.map(([text, href]) => <li><a class="hover:underline decoration-brand decoration-2 underline-offset-4" href={href}>{text}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class={wrap}><div class="flex flex-wrap items-center justify-between gap-3 border-t py-5 font-mono text-xs text-muted-foreground">
      <span>MIT licensed. k6 is installed separately under AGPL-3.0.</span>
      <a class="hover:text-foreground" href={doc("THIRD_PARTY_NOTICES.md")}>Third-party notices</a></div>
    </div>
  </footer>
</Base>

<script>
  // Theme toggle: saves an explicit light/dark choice; with none saved the tokens follow the OS.
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle")!;
  const os = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => root.classList.contains("dark") || (!root.classList.contains("light") && os.matches);
  const sync = () => toggle.setAttribute("aria-pressed", String(isDark()));
  toggle.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.classList.remove("light", "dark");
    root.classList.add(next);
    try {
      localStorage.setItem("litetraffic-theme", next);
    } catch (_) {
      /* The choice still applies for this visit. */
    }
    sync();
  });
  os.addEventListener("change", sync);
  sync();
</script>
