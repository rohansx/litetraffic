---
// ponytail: placeholder that proves the shared tokens load; the site agent ports site/ here.
import Base from "../layouts/Base.astro";
---
<Base
  title="LiteTraffic — Users as an API"
  description="LiteTraffic runs stateful synthetic users against a running app on a seeded schedule, checks the business effects they leave behind, and keeps the evidence."
>
  <header class="mx-auto flex min-h-20 max-w-6xl items-center justify-between gap-5 border-b px-4">
    <a class="flex items-center gap-2 font-display text-lg font-bold" href="/" aria-label="LiteTraffic home">
      <svg class="size-7 fill-foreground" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 17h4v11H4zm7-9h4v20h-4zm7 5h4v15h-4zm7-9h4v24h-4z"></path></svg>
      <span>LiteTraffic</span>
    </a>
    <a class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground" href="https://github.com/rohansx/litetraffic">GitHub</a>
  </header>
  <main class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="font-display text-6xl font-extrabold">Users<br />as an API.</h1>
  </main>
</Base>
