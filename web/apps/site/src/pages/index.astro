---
import Base from "../layouts/Base.astro";
import DashboardMock from "../components/DashboardMock.astro";
import Mechanics from "../components/Mechanics.astro";
import Details from "../components/Details.astro";
import VerdictBadge from "../components/VerdictBadge.astro";
import { badgeOutline, badgeSecondary, button, buttonGhostSm, buttonIcon, buttonOutline, buttonOutlineSm, card, cardDescription, cardTitle, h2, label, lead, section, wrap } from "../lib/ui";

const logo = "M4 17h4v11H4zm7-9h4v20h-4zm7 5h4v15h-4zm7-9h4v24h-4z";
const bars = [25, 25, 26, 24, 30, 34, 55, 81, 92, 72, 43, 31, 25, 26, 25, 25];
const nav = [
  ["#mechanics", "How it works"],
  ["#isolation", "Tenant isolation"],
  ["#dashboard", "Evidence"],
  ["#commands", "Commands"],
];
const repo = "https://github.com/rohansx/litetraffic";
---
<Base
  title="LiteTraffic — Users as an API"
  description="LiteTraffic runs stateful synthetic users against a running app on a seeded schedule, checks the business effects they leave behind, and keeps the evidence."
>
  <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <div class={`${wrap} flex h-14 items-center justify-between gap-4`}>
      <a class="flex items-center gap-2 font-heading text-base font-semibold whitespace-nowrap" href="#main" aria-label="LiteTraffic home">
        <span class="grid size-7 place-items-center rounded-md bg-primary text-primary-foreground"><svg class="size-4 fill-current" viewBox="0 0 32 32" aria-hidden="true"><path d={logo}></path></svg></span><span>LiteTraffic</span>
      </a>
      <nav class="flex items-center gap-1" aria-label="Main navigation">
        {nav.map(([href, text]) => <a class={`${buttonGhostSm} text-muted-foreground max-lg:hidden`} href={href}>{text}</a>)}
        <a class={`${buttonOutlineSm} ml-1`} href="#start">Get started</a>
        <button id="theme-toggle" type="button" class={buttonIcon} aria-label="Dark mode" aria-pressed="false">
          <svg class="fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path class="fill-current stroke-none" d="M12 3a9 9 0 0 1 0 18z"></path></svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class={`${wrap} grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_1fr] lg:gap-16`} aria-labelledby="hero-title">
      <div>
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border bg-background px-3 py-1 text-sm font-medium shadow-xs">
          <span class="size-1.5 rounded-full bg-pass" aria-hidden="true"></span> Open developer preview, 0.1.0.dev0
        </p>
        <h1 id="hero-title" class="font-heading text-5xl leading-[1.02] font-bold tracking-tight sm:text-6xl lg:text-7xl">Users<br />as an API.</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">Give a running app a population of stateful synthetic users. Replay what they do under bounded traffic. Check whether the right business effects survive.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class={button} href="#start">Run a scenario</a>
          <a class={buttonOutline} href="#dashboard">See the evidence</a>
        </div>
        <p class="mt-6 text-sm text-muted-foreground">Localhost, CI preview, or an existing E2B sandbox. No hosted account.</p>
      </div>

      <div
        class={`${card} min-w-0 gap-0 py-0`}
        role="img"
        aria-label="Illustrative checkout run: 12 buyers, cart to order to payment to retry, a seeded burst over 90 seconds, and a passing check of one ledger effect per payment"
      >
        <div class="flex items-start justify-between gap-3 border-b px-6 py-5">
          <div class="grid gap-1.5"><span class={cardTitle}>checkout / scenario 01</span><span class={cardDescription}>Seed 42, 90 seconds</span></div>
          <span class={badgeSecondary}>illustrative run</span>
        </div>
        <div class="grid grid-cols-[80px_1fr_auto] items-center gap-3 border-b px-6 py-4">
          <span class="text-sm text-muted-foreground">Population</span>
          <div class="flex pl-2" aria-hidden="true">
            {["B", "B", "B", "+9"].map((a, i) => (
              <i class:list={["-ml-2 grid size-7 place-items-center rounded-full border-2 border-card text-[11px] font-medium not-italic", i === 3 ? "bg-muted text-muted-foreground" : "bg-primary text-primary-foreground"]}>{a}</i>
            ))}
          </div>
          <strong class="text-sm font-medium">12 buyers</strong>
        </div>
        <div class="grid items-center gap-2 border-b px-6 py-4 sm:grid-cols-[80px_1fr] sm:gap-3">
          <span class="text-sm text-muted-foreground">Journey</span>
          <div class="flex items-center gap-1.5">
            {["cart", "order", "pay", "retry"].map((step, i) => (
              <>
                {i > 0 && <b class="h-px min-w-1 flex-1 bg-border"></b>}
                <span class={badgeOutline}>{step}</span>
              </>
            ))}
          </div>
        </div>
        <div class="border-b px-6 py-5">
          <div class="flex justify-between text-xs text-muted-foreground tabular-nums"><span>Journeys / second</span><span>90 seconds</span></div>
          <div class="mt-4 flex h-24 items-end gap-1 border-b" aria-hidden="true">
            {bars.map((h) => <i class="flex-1 rounded-t-sm bg-primary/85" style={`height:${h}%`}></i>)}
          </div>
          <div class="mt-2 flex justify-between text-xs text-muted-foreground"><span>baseline</span><span>burst</span><span>recovery</span></div>
        </div>
        <div class="flex items-center gap-3 px-6 py-4">
          <span class="grid size-8 place-items-center rounded-md border bg-muted" aria-hidden="true"><svg class="size-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg></span>
          <span><small class="block text-xs text-muted-foreground">Business assertion</small><strong class="block text-sm font-medium">One ledger effect per payment</strong></span>
          <VerdictBadge verdict="pass" class="ml-auto" />
        </div>
      </div>
    </section>

    <div class="border-y bg-muted/40">
      <div class={`${wrap} grid text-sm font-medium sm:grid-cols-3`}>
        {["Believable users", "Controlled pressure", "Proof of effect"].map((t) => (
          <span class="flex items-center gap-2.5 border-b py-4 last:border-b-0 sm:border-r sm:border-b-0 sm:px-5 sm:py-5 sm:first:pl-0 sm:last:border-r-0">
            <svg class="size-4 fill-none stroke-muted-foreground stroke-2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.5 2.5 4.5-5"></path></svg>{t}
          </span>
        ))}
      </div>
    </div>

    <section class={`${wrap} ${section} grid items-center gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-20`} id="mechanics">
      <div>
        <p class={label}>Why this exists</p>
        <h2 class={h2}>A response is only half the story.</h2>
        <p class={lead}>Load tests count responses. A real user carries state across requests, retries an action, and expects the system to leave the right result behind. LiteTraffic tests that complete chain.</p>
      </div>
      <div class={`${card} gap-0 py-0`} aria-label="Example of a fast but incorrect checkout response">
        <div class="flex justify-between gap-3 border-b px-6 py-5 text-sm">
          <span class="text-muted-foreground">What a load test sees</span>
          <strong class="text-right font-medium tabular-nums">HTTP 200 <small class="mt-1 block text-xs font-normal text-muted-foreground">31 ms</small></strong>
        </div>
        <div class="flex justify-between gap-3 border-b px-6 py-5 text-sm">
          <span class="text-muted-foreground">What the customer gets</span>
          <strong class="text-right font-medium text-fail tabular-nums">2 charges <small class="mt-1 block text-xs font-normal text-muted-foreground">for 1 payment</small></strong>
        </div>
        <p class="bg-muted/50 px-6 py-4 text-sm font-medium rounded-b-xl">A fast response can still be a failed checkout.</p>
      </div>
    </section>

    <Mechanics />

    <section class={`${wrap} ${section}`} id="dashboard" aria-labelledby="dashboard-title">
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <div>
          <p class={label}>Local dashboard</p>
          <h2 id="dashboard-title" class={h2}>Read the failure, not a log.</h2>
          <p class={lead}>When a check fails, the run keeps the first failing samples with what the scenario expected and what the app actually did. <code>litetraffic dashboard</code> lists every run on your machine, filters them by scenario, verdict and seed, compares any two you tick, and charts p95 latency per scenario.</p>
        </div>
        <ul class="grid gap-3 self-end text-sm sm:grid-cols-2">
          <li class="rounded-xl border bg-card px-4 py-3.5 shadow-sm">Binds to 127.0.0.1 only, with no host option. Requests with any other <code>Host</code> header are refused.</li>
          <li class="rounded-xl border bg-card px-4 py-3.5 shadow-sm">Read-only. It serves run artifacts and never contacts a target.</li>
          <li class="rounded-xl border bg-card px-4 py-3.5 shadow-sm">Follows your light or dark setting, and fits a phone screen.</li>
          <li class="rounded-xl border bg-card px-4 py-3.5 shadow-sm">Python standard library. Nothing else to install.</li>
        </ul>
      </div>
      <div class="mt-10 sm:mt-14"><DashboardMock /></div>
    </section>

    <Details />
  </main>

  <footer class="border-t">
    <div class={`${wrap} grid gap-4 py-8 text-sm sm:flex sm:items-center sm:justify-between sm:gap-6`}>
      <a class="flex items-center gap-2 font-heading font-semibold" href="#main">
        <span class="grid size-7 place-items-center rounded-md bg-primary text-primary-foreground"><svg class="size-4 fill-current" viewBox="0 0 32 32" aria-hidden="true"><path d={logo}></path></svg></span><span>LiteTraffic</span>
      </a>
      <p class="text-muted-foreground">Users as an API. Evidence as the result. MIT licensed.</p>
      <div class="flex gap-5 text-muted-foreground">
        <a class="hover:text-foreground hover:underline underline-offset-4" href={repo}>GitHub</a>
        <a class="hover:text-foreground hover:underline underline-offset-4" href={`${repo}/tree/main/docs`}>Documentation</a>
        <a class="hover:text-foreground hover:underline underline-offset-4" href={`${repo}/blob/main/docs/cli.md`}>CLI reference</a>
      </div>
    </div>
  </footer>
</Base>

<script>
  // Theme toggle: saves an explicit light/dark choice; with none saved the tokens follow the OS.
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle")!;
  const os = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => root.classList.contains("dark") || (!root.classList.contains("light") && os.matches);
  const sync = () => {
    toggle.setAttribute("aria-pressed", String(isDark()));
  };
  toggle.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.classList.remove("light", "dark");
    root.classList.add(next);
    try {
      localStorage.setItem("litetraffic-theme", next);
    } catch (_) {
      /* The choice still applies for this visit. */
    }
    sync();
  });
  os.addEventListener("change", sync);
  sync();
</script>
